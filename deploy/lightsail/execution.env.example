# Copy to /opt/tw-quant/config/execution.env and chmod 600.
# Default remains locked. Enabling canary requires a separate readiness review.
BROKER_PROVIDER=disabled
LIVE_BROKER_CONNECTION_ID=primary
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
LIVE_CANARY_ENABLED=false
LIVE_CANARY_CONFIRMATION=
LIVE_CANARY_ALLOWED_OWNER_IDS=
LIVE_CANARY_ALLOWED_SYMBOLS=
LIVE_CANARY_ALLOWED_CONTRACTS=
LIVE_CANARY_MAX_QUANTITY=1
LIVE_CANARY_ARM_TTL_SECONDS=600
LIVE_CANARY_PROTECTIVE_STOP_TICKS=20
LIVE_ORDER_REQUESTS_PER_MINUTE=4
# Read-only and canary are mutually exclusive effective modes.
LIVE_BROKER_READ_ONLY_ENABLED=false
LIVE_BROKER_READ_ONLY_CONFIRMATION=
# JSON list; for example [{"symbol":"TMF","contract":"TMF-202609","broker_contract":"TMFU6"}]
LIVE_BROKER_INSTRUMENT_MAP_JSON=
LIVE_BROKER_ACCOUNT_ID=
LIVE_ALLOWED_ACCOUNT_IDS=
LIVE_BROKER_SECRET_REF=environment:primary
LIVE_EXECUTION_DB_PATH=/data/live_market.sqlite3
LIVE_EXECUTION_HEALTH_PATH=/run/tw-quant-execution/health.json
LIVE_EXECUTION_HEARTBEAT_SECONDS=5
LIVE_RECONCILIATION_INTERVAL_SECONDS=45
LIVE_RECONCILIATION_TIMEOUT_SECONDS=20
LIVE_RECONCILIATION_STALE_SECONDS=120
LIVE_CALLBACK_QUEUE_SIZE=1024
LIVE_CALLBACK_SHUTDOWN_DRAIN_SECONDS=5

# Live-only credentials. Never copy these keys into market.env or gateway.env.
SJ_API_KEY=
SJ_SECRET_KEY=
SJ_CA_CERT_PATH=/run/live-secrets/shioaji-ca.pfx
SJ_CA_PASSWORD=
