# Public DNS name pointing to the Lightsail static IP.
MARKET_DOMAIN=tmf.example.com
ACME_EMAIL=owner@example.com

# Caddy basic authentication protects the Dashboard, REST and WebSocket.
DASHBOARD_USER=replace-on-server
# Generate with: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'a-long-random-password'
# Keep a real hash in single quotes so every '$' remains literal.
DASHBOARD_PASSWORD_HASH='replace-with-caddy-hash'
