# Copy to /opt/tw-quant/config/market.env and chmod 600.
# This quote-only phase never activates a CA and cannot place orders.
MARKET_DATA_PROVIDER=replay
# Deprecated compatibility fallback (use only when MARKET_DATA_PROVIDER is absent):
# MARKET_MODE=mock
MARKET_SYMBOL=TMF
MARKET_CONTRACT=TMFR1
MARKET_DB_PATH=/data/live_market.sqlite3
MARKET_REPLAY_CSV=/app/data/mock_tmf_ticks.csv
MARKET_REPLAY_SPEED=8
MARKET_HEARTBEAT_SECONDS=5
MARKET_HISTORY_DAYS=30
MARKET_HISTORY_LIMIT=50000
MARKET_ALLOWED_ORIGINS=https://tmf.example.com
MARKET_HOLIDAYS=

# Production origin authentication. Create a Cloudflare Access self-hosted
# application first, then copy its team domain and Application Audience tag.
MARKET_ACCESS_MODE=cloudflare
CF_ACCESS_TEAM_DOMAIN=replace.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-application-audience-tag

# Replace only on the server. Never commit real values.
SJ_API_KEY=replace-on-server
SJ_SEC_KEY=replace-on-server
SJ_PRODUCTION=false
