# Copy to /opt/tw-quant/config/market.env and chmod 600.
# This quote-only phase never activates a CA and cannot place orders.
MARKET_MODE=mock
MARKET_SYMBOL=TMF
MARKET_CONTRACT=TMFR1
MARKET_DB_PATH=/data/live_market.sqlite3
MARKET_REPLAY_CSV=/app/data/mock_tmf_ticks.csv
MARKET_REPLAY_SPEED=8
MARKET_HEARTBEAT_SECONDS=5
MARKET_ALLOWED_ORIGINS=https://tmf.example.com
MARKET_HOLIDAYS=

# Replace only on the server. Never commit real values.
SJ_API_KEY=replace-on-server
SJ_SEC_KEY=replace-on-server
SJ_PRODUCTION=false
