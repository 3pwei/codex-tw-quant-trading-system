# Copy to /opt/tw-quant/config/market.env and chmod 600.
# This quote-only phase never activates a CA and cannot place orders.
MARKET_DATA_PROVIDER=replay
# Deprecated compatibility fallback (use only when MARKET_DATA_PROVIDER is absent):
# MARKET_MODE=mock
MARKET_SYMBOL=TMF
MARKET_CONTRACT=TMFR1
MARKET_DB_PATH=/data/live_market.sqlite3
MARKET_REPLAY_CSV=/app/data/mock_tmf_ticks.csv
MARKET_REPLAY_SPEED=8
MARKET_HEARTBEAT_SECONDS=5
# New Paper positions fail closed when the most recent Tick is older than this.
MARKET_STALE_AFTER_SECONDS=120
MARKET_HISTORY_DAYS=30
MARKET_HISTORY_LIMIT=50000
MARKET_ALLOWED_ORIGINS=https://tmf.example.com
MARKET_HOLIDAYS=

# Production origin authentication. Create a Cloudflare Access self-hosted
# application first, then copy its team domain and Application Audience tag.
PLATFORM_ENVIRONMENT=production

MARKET_ACCESS_MODE=cloudflare
CF_ACCESS_TEAM_DOMAIN=replace.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-application-audience-tag

# Production starts fail-closed unless both identity and RBAC are enforced.
PLATFORM_AUTHORIZATION_MODE=enforced
PLATFORM_BOOTSTRAP_ADMIN_EMAILS=owner@example.com

# Per-identity sliding-window limits. Values must remain positive.
RATE_LIMIT_ACCESS_REQUESTS_PER_HOUR=5
RATE_LIMIT_BACKTESTS_PER_MINUTE=10
RATE_LIMIT_REPLAY_PREPARES_PER_MINUTE=10
RATE_LIMIT_ORDERS_PER_MINUTE=30
API_MAX_REQUEST_BODY_BYTES=262144

# Replace only on the server. Never commit real values.
MARKET_SJ_API_KEY=replace-on-server
MARKET_SJ_SECRET_KEY=replace-on-server
MARKET_SJ_PRODUCTION=false
# Read-only cached execution health shared by named volume; never broker I/O.
LIVE_EXECUTION_HEALTH_PATH=/run/tw-quant-execution/health.json

# Live Shadow is a read/evaluate/audit path only. Keep disabled until the
# read-only soak passes. Values are server-owned; browsers cannot override them.
LIVE_SHADOW_ENABLED=false
LIVE_SHADOW_ALLOWED_SYMBOLS=TMF
LIVE_SHADOW_ALLOWED_CONTRACTS=replace-canonical-contract
LIVE_SHADOW_CONTRACT_EXPIRY=2099-12-31
LIVE_SHADOW_TICK_SIZE=1
LIVE_SHADOW_MULTIPLIER=10
LIVE_SHADOW_MAX_ORDER_QUANTITY=1
LIVE_SHADOW_MAX_ACCOUNT_POSITION=1
LIVE_SHADOW_MAX_PORTFOLIO_POSITION=1
LIVE_SHADOW_MAX_RISK_PER_TRADE=5000
LIVE_SHADOW_MAX_DAILY_LOSS=10000
LIVE_SHADOW_MAX_DAILY_TRADES=10
LIVE_SHADOW_MAX_PENDING_ORDERS=1
LIVE_SHADOW_MAX_QUOTE_AGE_SECONDS=2
LIVE_SHADOW_MAX_SLIPPAGE_TICKS=2
LIVE_SHADOW_MAX_SPREAD_TICKS=4
LIVE_SHADOW_ALLOWED_SESSIONS=day,night
LIVE_SHADOW_EXPIRY_GUARD_DAYS=2
LIVE_SHADOW_MAX_ACTIVE_RUNTIMES=1
# Map platform owner IDs to opaque target IDs shown by the authenticated API.
# Never put broker account IDs or credentials in this market-api environment.
LIVE_SHADOW_OWNER_TARGETS_JSON={}

# Manual Live Canary public-process metadata. No account ID or credential belongs
# here; LIVE_CANARY_TARGET_ID is the opaque target ID from operational health.
LIVE_CANARY_ENABLED=false
LIVE_CANARY_ALLOWED_OWNER_ID=
LIVE_CANARY_TARGET_ID=
LIVE_CANARY_ALLOWED_SYMBOLS=
LIVE_CANARY_ALLOWED_CONTRACTS=
LIVE_CANARY_MAX_QUANTITY=1
LIVE_CANARY_ARM_TTL_SECONDS=600
LIVE_CANARY_PROTECTIVE_STOP_TICKS=20
# Market API persists canonical BidAsk to the shared SQLite boundary for the
# isolated Position Guardian. It never receives broker credentials.
LIVE_ORDER_REQUESTS_PER_MINUTE=4
