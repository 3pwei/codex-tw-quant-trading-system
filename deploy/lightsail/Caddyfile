{
	admin off
	email {$ACME_EMAIL}
}

{$MARKET_DOMAIN} {
	encode zstd gzip

	@health path /healthz
	respond @health "ok" 200

	@protected not path /healthz
	basic_auth @protected {
		{$DASHBOARD_USER} {$DASHBOARD_PASSWORD_HASH}
	}

	@backend path /api/* /ws/* /docs* /openapi.json /health/live
	reverse_proxy @backend market-api:8000

	root * /srv
	try_files {path} {path}/index.html /404.html
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}
}
