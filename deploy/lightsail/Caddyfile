{
	admin off
	email {$ACME_EMAIL}
}

{$MARKET_DOMAIN} {
	encode zstd gzip

	route {
		@health path /healthz
		respond @health "ok" 200

		forward_auth market-api:8000 {
			uri /internal/auth/cloudflare
			# Keep the auth probe as regular HTTP even when the original request
			# is a WebSocket handshake.
			header_up -Connection
			header_up -Upgrade
			copy_headers X-Authenticated-Subject X-Authenticated-Email
		}

		@backend path /api/* /ws/* /docs* /openapi.json /health/live
		reverse_proxy @backend market-api:8000

		root * /srv
		try_files {path} {path}/index.html /404.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}
}
