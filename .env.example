# Market-data adapter: replay or shioaji.
MARKET_DATA_PROVIDER=replay
# Deprecated compatibility fallback (use only when MARKET_DATA_PROVIDER is absent):
# MARKET_MODE=mock
MARKET_SYMBOL=TMF
MARKET_CONTRACT=TMFR1
MARKET_DB_PATH=output/live_market.sqlite3
MARKET_REPLAY_CSV=data/mock_tmf_ticks.csv
MARKET_REPLAY_SPEED=8
MARKET_ALLOWED_ORIGINS=http://localhost:3000,https://3pwei.github.io
MARKET_HEARTBEAT_SECONDS=5
MARKET_HISTORY_DAYS=30
MARKET_HISTORY_LIMIT=50000
# Comma-separated TAIFEX full-day holidays used for night trading-date rollover.
MARKET_HOLIDAYS=

# Local development is intentionally unauthenticated. Production uses
# Cloudflare Access and validates its signed JWT again at the origin.
PLATFORM_ENVIRONMENT=development

MARKET_ACCESS_MODE=disabled
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-application-audience-tag

# Local-only authorization bypass. Production refuses to start with this value.
PLATFORM_AUTHORIZATION_MODE=disabled
PLATFORM_BOOTSTRAP_ADMIN_EMAILS=owner@example.com

# Per-identity sliding-window limits for resource-intensive APIs.
RATE_LIMIT_ACCESS_REQUESTS_PER_HOUR=5
RATE_LIMIT_BACKTESTS_PER_MINUTE=10
RATE_LIMIT_REPLAY_PREPARES_PER_MINUTE=10
RATE_LIMIT_ORDERS_PER_MINUTE=30
API_MAX_REQUEST_BODY_BYTES=262144

# Shioaji market-data credentials. These are quote credentials only and must
# remain separate from any future broker-account/order credentials.
MARKET_SJ_API_KEY=replace-with-market-data-key
MARKET_SJ_SECRET_KEY=replace-with-market-data-secret
MARKET_SJ_PRODUCTION=false

# Live Shadow only: server-owned limits and opaque owner target authorization.
# It never enables broker submit/cancel and is disabled by default.
LIVE_SHADOW_ENABLED=false
LIVE_SHADOW_ALLOWED_SYMBOLS=TMF
LIVE_SHADOW_ALLOWED_CONTRACTS=replace-canonical-contract
LIVE_SHADOW_CONTRACT_EXPIRY=2099-12-31
LIVE_SHADOW_TICK_SIZE=1
LIVE_SHADOW_MULTIPLIER=10
LIVE_SHADOW_MAX_ORDER_QUANTITY=1
LIVE_SHADOW_MAX_ACCOUNT_POSITION=1
LIVE_SHADOW_MAX_PORTFOLIO_POSITION=1
LIVE_SHADOW_MAX_RISK_PER_TRADE=5000
LIVE_SHADOW_MAX_DAILY_LOSS=10000
LIVE_SHADOW_MAX_DAILY_TRADES=10
LIVE_SHADOW_MAX_PENDING_ORDERS=1
LIVE_SHADOW_MAX_QUOTE_AGE_SECONDS=2
LIVE_SHADOW_MAX_SLIPPAGE_TICKS=2
LIVE_SHADOW_MAX_SPREAD_TICKS=4
LIVE_SHADOW_ALLOWED_SESSIONS=day,night
LIVE_SHADOW_EXPIRY_GUARD_DAYS=2
LIVE_SHADOW_MAX_ACTIVE_RUNTIMES=1
LIVE_SHADOW_OWNER_TARGETS_JSON={}

# Dashboard build-time backend URL
NEXT_PUBLIC_MARKET_API_URL=http://localhost:8000
NEXT_PUBLIC_BASE_PATH=
