# Backend mode: mock or shioaji
MARKET_MODE=mock
MARKET_SYMBOL=TMF
MARKET_CONTRACT=TMFR1
MARKET_DB_PATH=output/live_market.sqlite3
MARKET_REPLAY_CSV=data/mock_tmf_ticks.csv
MARKET_REPLAY_SPEED=8
MARKET_ALLOWED_ORIGINS=http://localhost:3000,https://3pwei.github.io
MARKET_HEARTBEAT_SECONDS=5
MARKET_HISTORY_DAYS=30
MARKET_HISTORY_LIMIT=50000
# Comma-separated TAIFEX full-day holidays used for night trading-date rollover.
MARKET_HOLIDAYS=

# Local development is intentionally unauthenticated. Production uses
# Cloudflare Access and validates its signed JWT again at the origin.
MARKET_ACCESS_MODE=disabled
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-application-audience-tag

# Shioaji market-data credentials. Never commit real values.
SJ_API_KEY=replace-with-api-key
SJ_SEC_KEY=replace-with-secret-key
SJ_PRODUCTION=false

# CA is not used by this quote-only service. Keep these unset until an
# explicitly reviewed trading phase needs them.
SJ_CA_PATH=
SJ_CA_PASSWD=
SJ_PERSON_ID=

# Dashboard build-time backend URL
NEXT_PUBLIC_MARKET_API_URL=http://localhost:8000
NEXT_PUBLIC_BASE_PATH=
